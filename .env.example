# Supabase — painel do projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor (NUNCA exponha com NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — para o parsing de tabelas (épico E2) e busca conversacional (E7)
ANTHROPIC_API_KEY=

# URL pública do app (usada nos links de convite/recuperação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Teste de RLS (npm run test:rls) — usuários de teste criados no Supabase
RLS_TEST_BROKER_EMAIL=corretor@jf.dev
RLS_TEST_BROKER_PASSWORD=
RLS_TEST_ADMIN_EMAIL=admin@horizonte.dev
RLS_TEST_ADMIN_PASSWORD=
